# ============================================
# MCP DataGouv Explorer — Configuration
# ============================================
# Copiez ce fichier en .env.local et remplissez vos valeurs

# Clé API Mistral — https://console.mistral.ai/
# (ou n'importe quel provider compatible, adaptez le code si besoin)
MISTRAL_API_KEY=votre_clef_api_ici

# Modèle Mistral (défaut: mistral-small-latest)
MISTRAL_MODEL=mistral-small-latest

# Limites de requêtes
RATE_LIMIT_PER_SESSION=5
RATE_LIMIT_DAILY=50
